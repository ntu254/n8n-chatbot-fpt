# Server port
PORT=3000

# Your n8n webhook endpoint (use production /webhook, not /webhook-test)
# Example: https://nttu254.app.n8n.cloud/webhook/b1269f08-4273-48f6-bd24-178d1e8b9816
N8N_WEBHOOK_URL=https://nttu254.app.n8n.cloud/webhook/b1269f08-4273-48f6-bd24-178d1e8b9816

# Optional auth header to pass to n8n (if your webhook requires Header Auth)
# e.g. N8N_AUTH_HEADER=Authorization
#      N8N_AUTH_VALUE=Bearer YOUR_SUPER_SECRET_TOKEN
N8N_AUTH_HEADER=Authorization
N8N_AUTH_VALUE=YOUR_SUPER_SECRET_TOKEN

# Allowed origin for CORS (web app origin)
CORS_ORIGIN=http://localhost:3000