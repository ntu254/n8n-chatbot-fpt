# API base URL for mobile app
# Local dev (Express proxy in this repo):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Android emulator (host machine loopback):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Production (Vercel domain hosting /api/chat):
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.vercel.app

# If you want to use the Spring Boot backend (default port 8080):
# Local iOS simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Google OAuth client IDs for Expo (development), Android and iOS
# Create credentials in Google Cloud Console:
# - OAuth client ID (Web) for Expo Go (development) -> use as EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID
# - OAuth client ID (Android) -> EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
# - OAuth client ID (iOS) -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=